# --- Сайт WARDOGS ---
# development для локального запуска; production включает fail-closed проверки.
WARDOGS_ENV=production
# Публичный адрес, на котором открыт сайт (базовая часть, без пути).
# Для Steam/Discord OAuth должен совпадать с тем, что настроено у провайдеров.
WARDOGS_PUBLIC_URL=https://panel.dendich.online
# В production укажите домен сайта; несколько значений разделяйте запятыми.
WARDOGS_ALLOWED_HOSTS=panel.dendich.online
WARDOGS_HOST=127.0.0.1
WARDOGS_PORT=8236
# Bothost задаёт PORT сам; не прописывайте его вручную в локальном .env.
# Для PostgreSQL укажите postgresql://user:password@host:5432/database.
# Если оставить пустым, используется локальный SQLite (режим разработки).
WARDOGS_DATABASE_URL=
WARDOGS_DB=site.db
# Только для одного экземпляра панели с постоянным диском (например Bothost).
# Для VPS с несколькими процессами используйте PostgreSQL и оставьте 0.
WARDOGS_ALLOW_SQLITE_PRODUCTION=1
WARDOGS_DB_POOL_MIN=1
WARDOGS_DB_POOL_MAX=10
WARDOGS_DB_COMMAND_TIMEOUT=30
WARDOGS_MAX_BODY_BYTES=262144
WARDOGS_MAX_RCON_RESPONSE_BYTES=2097152
WARDOGS_PLAYER_ACTIVITY_RETENTION_DAYS=90
# В production HTTP-RCON для внешних хостов запрещён; лучше использовать HTTPS.
# 1 — пока игровой RCON доступен по обычному HTTP.
WARDOGS_ALLOW_INSECURE_RCON=1
# Только для локальной разработки. Никогда не включайте на публичном сервере.
WARDOGS_DEV_AUTH=0
# Allowlist для админ-API: IP через запятую или CIDR (например 203.0.113.7,10.0.0.0/8). Пусто = без ограничений.
WARDOGS_ADMIN_IPS=
# Интервал проверки RCON и необязательный Discord/webhook для событий online/offline.
WARDOGS_HEALTHCHECK_INTERVAL=60
WARDOGS_ALERT_WEBHOOK_URL=

# --- Steam ---
# Необязательно: чтобы показывать реальный ник, нужен ключ Steam Web API.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_REGRESSION=0

# --- Discord OAuth2 (привязка) ---
# Создайте приложение: https://discord.com/developers/applications
# Redirect URI: <WARDOGS_PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Токен Discord-бота (тот же, что у wardogs-monitor) — нужен, чтобы сайт
# читал роли пользователя из вашей гильдии.
DISCORD_BOT_TOKEN=
WARDOGS_GUILD_ID=

# Внутренний API «Асуны Юки» для управления временными комнатами.
# URL должен быть доступен только панели; токен совпадает с PANEL_BRIDGE_TOKEN бота.
DISCORD_BOT_PANEL_URL=http://127.0.0.1:3000
DISCORD_BOT_PANEL_TOKEN=

# --- Роли админа из Discord ---
# Через запятую: ID роли или точное имя. Кто попал — получает управление.
# Напр.: WARDOGS_ADMIN_ROLES=123456789012345678,Смотритель сервера
WARDOGS_ADMIN_ROLES=

# --- RCON-серверы (см. servers.json) ---
# Токены лучше хранить здесь, а поле token в servers.json оставлять пустым.
# Имя переменной строится из id сервера в верхнем регистре.
RCON_TOKEN_RU1=
RCON_TOKEN_RU2=

# --- Bothost (необязательно) ---
# Вместо загрузки servers.json можно передать всю конфигурацию как секретную
# переменную окружения. Токены лучше оставить отдельными RCON_TOKEN_<ID>.
# WARDOGS_SERVERS_JSON={"refresh_seconds":5,"servers":[{"id":"ru1","name":"WARDOGS RU #1","host":"127.0.0.1","port":7789,"scheme":"http","token":""}]}
