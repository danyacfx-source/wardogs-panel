# Discord
DISCORD_TOKEN=

# Основной сервер
GUILD_ID=

# ---- Тикеты ----
TICKET_GUILD_ID=
TICKET_CATEGORY=
TICKET_STAFF_ROLES=
TICKET_LOG_CHANNEL=
TICKET_TRANSCRIPT_CHANNEL=
TICKET_ALLOWED_EVERYONE_OPEN=5

# ---- Регистрация кланов (если пусто — наследуется из тикетов) ----
CLAN_TICKET_CATEGORY=
CLAN_TICKET_STAFF_ROLES=
CLAN_TICKET_LOG_CHANNEL=
CLAN_TICKET_TRANSCRIPT_CHANNEL=

# ---- Войс ----
VC_TRIGGER_CHANNEL=
VC_CATEGORY=
VC_CONTROL_CHANNEL=

# ---- Логи ----
LOG_CHANNEL=

# ---- Перевод ----
# Автоперевод только в этих каналах (через запятую), язык назначения.
# Если переменная пустая — каналы берутся из config.py (новостной канал 1543603551564079204 и 1547304972054691900).
TRANSLATE_CHANNELS=
TRANSLATE_TARGET=ru
# Бесплатный AI-переводчик Gemini (https://aistudio.google.com), основной движок.
# Пусто или нет файла .env — берётся захардкоженный в config.py ключ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Резервный AI-переводчик Groq (https://console.groq.com). Пусто = Google/MyMemory.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Фон rank-карточки: полный путь к картинке (PNG/JPG). Пусто = градиент.
RANK_BACKGROUND=

# ---- Стримеры ----
# Стартовые стримеры (логины через запятую), добавляются в БД при первом запуске
TWITCH_CHANNELS=
TWITCH_ANNOUNCE_CHANNEL=
TWITCH_CHECK_INTERVAL=60

# ---- Зеркало (пункт 6) ----
# Разрешённые пользователи для команд /mirror (через запятую, пусто = только админы)
MIRROR_ADMINS=

# ---- Роли активности (JSON массив) ----
# type: "voice_hours" | "messages" | "level"
# Поля: role_id — роль для выдачи, prev_role_id — снять предыдущую (иерархия повышения)
# Пример: [{"role_id":111,"type":"level","level":5}]
#         [{"role_id":222,"type":"voice_hours","hours":10},{"role_id":333,"type":"messages","count":500}]
ACTIVITY_ROLES_CONFIG='[{ "role_id": 0, "type": "level", "level": 5 }]'
# Канал для авто-бэкапов БД (id канала)
BACKUP_CHANNEL_ID=

# ---- Каналы-ловушки (сообщение = кик) ----
# Жёстко зашитые каналы-ловушки (через запятую). Основной способ назначения — /trap (в БД).
TRAP_CHANNEL_IDS=
# Канал для логов срабатывания ловушки (по умолчанию — логи модерации 1546556555036721252)
TRAP_LOG_CHANNEL=

# ============================================================
# Единый бот: донат + кланы + сидинг (порты из donation-bot,
# clans-bot, seeding-bot). Один .env — один процесс.
# ============================================================

# ---- Донат (фид panel.dendich.online) ----
SITE_BASE_URL=https://panel.dendich.online
CHECKOUT_SECRET=
FEED_TOKEN=
POLL_SECONDS=45

# ---- Кланы (синхронизация с панелью) ----
CLAN_SYNC_URL=https://panel.dendich.online/api/public/clan-sync
CLAN_SYNC_SECRET=
CLAN_BACKUP_SECRET=
CLAN_BACKUP_INTERVAL_HOURS=24
CLAN_BACKUP_RETENTION=30
# DATA_DIR и BACKUP_DIR на Bothost: /app/data и /app/data/backups
DATA_DIR=./data
BACKUP_DIR=./data/backups
# Необязательные: 0 = отключено
CLAN_ADMIN_ROLE_ID=0
CLAN_BACKUP_CHANNEL_ID=0

# ---- Сидинг (WDRCON HTTP API игровых серверов) ----
# URL — прямой listener WDRCON, не HTML-консоль.
SEED_RCON_URL=
SEED_RCON_PASSWORD=
SEED_RCON_2_URL=
SEED_RCON_2_PASSWORD=
SEED_RCON_TIMEOUT_MS=6000
SEED_RCON_RETRY=1
# Окно начисления баллов, МСК
SEED_START_TIME=06:00
SEED_END_TIME=22:00
SEED_STOP_PLAYER_COUNT=20
SEED_RESUME_BELOW_SECONDS=300
SEED_TICK_SECONDS=30
SEED_SESSION_GRACE_SECONDS=180
LEADERBOARD_REFRESH_SECONDS=60
WEEKLY_AWARD_RECONCILE_SECONDS=300
VIP_RECONCILE_SECONDS=120
DISCORD_ROLE_RECONCILE_SECONDS=300
DONATION_POLL_SECONDS_SEED=45
# Цены VIP за баллы сидинга
VIP_1_DAY_COST=120
VIP_7_DAY_COST=360
VIP_30_DAY_COST=720
# Роли/каналы (WARDOGS RU)
SEEDER_ROLE_ID=1552728825568174090
SUPER_SEEDER_ROLE_ID=1552841261713719440
VIP_ROLE_ID_SEED=1552725871830503484
SEED_VOICE_CHANNEL_ID=1552253117586739210
SEED_RANK_CHANNEL_ID=1552254053109727262
SEED_SHOP_CHANNEL_ID=1552255043757936721
SEED_RULES_CHANNEL_ID=1552254112060411944
SEED_AUDIT_CHANNEL_ID=1552402077068820611
SEED_BACKUP_CHANNEL_ID=1552401803184701502
LINK_CHALLENGE_MINUTES=5
LINK_CHALLENGE_MAX_ATTEMPTS=5
# Секрет для хеша кодов привязки (свой, любой длинный строкой)
SEED_CHALLENGE_KEY=wardogs-seeding-v1
SEED_GATHER_ROLE_ID=859738052666327040
