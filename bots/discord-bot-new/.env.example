# Discord
DISCORD_TOKEN=

# Основной сервер
GUILD_ID=

# ---- Тикеты ----
TICKET_GUILD_ID=
TICKET_CATEGORY=
TICKET_STAFF_ROLES=
TICKET_LOG_CHANNEL=
TICKET_TRANSCRIPT_CHANNEL=
TICKET_ALLOWED_EVERYONE_OPEN=5

# ---- Регистрация кланов (если пусто — наследуется из тикетов) ----
CLAN_TICKET_CATEGORY=
CLAN_TICKET_STAFF_ROLES=
CLAN_TICKET_LOG_CHANNEL=
CLAN_TICKET_TRANSCRIPT_CHANNEL=

# ---- Войс ----
VC_TRIGGER_CHANNEL=
VC_CATEGORY=
VC_CONTROL_CHANNEL=

# ---- Логи ----
LOG_CHANNEL=

# ---- Перевод ----
# Автоперевод только в этих каналах (через запятую), язык назначения.
# Если переменная пустая — каналы берутся из config.py (новостной канал 1543603551564079204 и 1547304972054691900).
TRANSLATE_CHANNELS=
TRANSLATE_TARGET=ru
# Бесплатный AI-переводчик Gemini (https://aistudio.google.com), основной движок.
# Пусто или нет файла .env — берётся захардкоженный в config.py ключ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Резервный AI-переводчик Groq (https://console.groq.com). Пусто = Google/MyMemory.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Фон rank-карточки: полный путь к картинке (PNG/JPG). Пусто = градиент.
RANK_BACKGROUND=

# ---- Стримеры ----
# Стартовые стримеры (логины через запятую), добавляются в БД при первом запуске
TWITCH_CHANNELS=
TWITCH_ANNOUNCE_CHANNEL=
TWITCH_CHECK_INTERVAL=60

# ---- Зеркало (пункт 6) ----
# Разрешённые пользователи для команд /mirror (через запятую, пусто = только админы)
MIRROR_ADMINS=

# ---- Роли активности (JSON массив) ----
# type: "voice_hours" | "messages" | "level"
# Поля: role_id — роль для выдачи, prev_role_id — снять предыдущую (иерархия повышения)
# Пример: [{"role_id":111,"type":"level","level":5}]
#         [{"role_id":222,"type":"voice_hours","hours":10},{"role_id":333,"type":"messages","count":500}]
ACTIVITY_ROLES_CONFIG='[{ "role_id": 0, "type": "level", "level": 5 }]'
# Канал для авто-бэкапов БД (id канала)
BACKUP_CHANNEL_ID=

# ---- Каналы-ловушки (сообщение = кик) ----
# Жёстко зашитые каналы-ловушки (через запятую). Основной способ назначения — /trap (в БД).
TRAP_CHANNEL_IDS=
# Канал для логов срабатывания ловушки (по умолчанию — логи модерации 1546556555036721252)
TRAP_LOG_CHANNEL=
