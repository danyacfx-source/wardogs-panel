# Discord
DISCORD_TOKEN=

# Основной сервер
GUILD_ID=

# ID владельца бота (для /streamers в ЛС)
OWNER_ID=

# ---- Тикеты ----
TICKET_GUILD_ID=
TICKET_CATEGORY=
TICKET_STAFF_ROLES=
TICKET_LOG_CHANNEL=
TICKET_TRANSCRIPT_CHANNEL=
TICKET_ALLOWED_EVERYONE_OPEN=5

# ---- Регистрация кланов ----
CLAN_TICKET_CATEGORY=
CLAN_TICKET_STAFF_ROLES=
CLAN_TICKET_LOG_CHANNEL=
CLAN_TICKET_TRANSCRIPT_CHANNEL=

# ---- Войс ----
VC_TRIGGER_CHANNEL=
VC_CATEGORY=
VC_CONTROL_CHANNEL=

# ---- Логи ----
LOG_CHANNEL=

# ---- Перевод ----
# Автоперевод в этих каналах (через запятую)
TRANSLATE_CHANNELS=
TRANSLATE_TARGET=ru
# Бесплатный AI-переводчик Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Фон rank-карточки: путь к картинке (PNG/JPG). Пусто = градиент.
RANK_BACKGROUND=

# ---- Стримеры ----
TWITCH_CHANNELS=
TWITCH_ANNOUNCE_CHANNEL=
TWITCH_CHECK_INTERVAL=60

# ---- Зеркало ----
MIRROR_ADMINS=

# ---- Роли активности (JSON массив) ----
# type: "voice_hours" | "messages" | "level"
# Поля: role_id, prev_role_id, hours/count/level
ACTIVITY_ROLES_CONFIG=[]

# Канал для авто-бэкапов БД
BACKUP_CHANNEL_ID=

# ---- Каналы-ловушки (сообщение = кик) ----
TRAP_CHANNEL_IDS=
TRAP_LOG_CHANNEL=

# ============================================================
# Единый бот: донат + кланы + сидинг. Один .env — один процесс.
# ============================================================

# ---- Донат (фид panel.dendich.online) ----
SITE_BASE_URL=https://panel.dendich.online
CHECKOUT_SECRET=
FEED_TOKEN=
POLL_SECONDS=45

# Донат: каналы и роли
DONATION_VIP_ROLE_ID=
DONATION_CHANNEL_SUPPORT=
DONATION_CHANNEL_VIP=
DONATION_CHANNEL_THANKS=
DONATION_CHANNEL_TOP=

# Тиры спонсорских ролей (JSON массив)
# Поля: name, roleId, min (копейки), icon
DONATION_TIERS=[{"name":"Друг стаи","roleId":1553090039615852675,"min":50000,"icon":"🐾"},{"name":"Снабженец","roleId":1553092734791983174,"min":250000,"icon":"📦"},{"name":"Опора стаи","roleId":1553093158441590975,"min":500000,"icon":"🛡️"},{"name":"Хранитель рубежа","roleId":1553093418031386714,"min":1000000,"icon":"⚔️"},{"name":"Легенда WARDOGS|RU","roleId":1553093599862988910,"min":2000000,"icon":"🏅"}]

# ---- Кланы (синхронизация с панелью) ----
CLAN_SYNC_URL=
CLAN_SYNC_SECRET=
CLAN_BACKUP_SECRET=
CLAN_BACKUP_INTERVAL_HOURS=24
CLAN_BACKUP_RETENTION=30
# На Bothost: /app/data и /app/data/backups
DATA_DIR=./data
BACKUP_DIR=./data/backups
CLAN_ADMIN_ROLE_ID=0
CLAN_BACKUP_CHANNEL_ID=0

# ---- Сидинг (WDRCON HTTP API игровых серверов) ----
SEED_RCON_URL=
SEED_RCON_PASSWORD=
SEED_RCON_2_URL=
SEED_RCON_2_PASSWORD=
SEED_RCON_TIMEOUT_MS=6000
SEED_RCON_RETRY=1
# Окно начисления баллов, МСК
SEED_START_TIME=06:00
SEED_END_TIME=22:00
SEED_STOP_PLAYER_COUNT=20
SEED_RESUME_BELOW_SECONDS=300
SEED_TICK_SECONDS=30
SEED_SESSION_GRACE_SECONDS=180
LEADERBOARD_REFRESH_SECONDS=60
WEEKLY_AWARD_RECONCILE_SECONDS=300
VIP_RECONCILE_SECONDS=120
DISCORD_ROLE_RECONCILE_SECONDS=300
DONATION_POLL_SECONDS_SEED=45
# Цены VIP за баллы сидинга
VIP_1_DAY_COST=120
VIP_7_DAY_COST=360
VIP_30_DAY_COST=720
# Роли/каналы сидинга
SEEDER_ROLE_ID=
SUPER_SEEDER_ROLE_ID=
VIP_ROLE_ID_SEED=
SEED_VOICE_CHANNEL_ID=
SEED_RANK_CHANNEL_ID=
SEED_SHOP_CHANNEL_ID=
