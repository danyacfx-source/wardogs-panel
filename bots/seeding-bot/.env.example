# Local testing only. BotHost.ru variables are listed in .env.bothost.example.
# Copy to .env only on a trusted computer and fill every CHANGE_ME value.

DISCORD_TOKEN=CHANGE_ME
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_GUILD_ID=403186008579112973
DISCORD_ADMIN_ROLE_IDS=805429609457254450,815605974412558376
SEEDER_ROLE_ID=1552728825568174090
SUPER_SEEDER_ROLE_ID=1552841261713719440
VIP_ROLE_ID=1552725871830503484
DISCORD_ROLE_RECONCILE_SECONDS=300
# Direct WDRCON listener of the game server, not the public HTML console.
WARDOGS_RCON_URL=http://51.83.166.12:7799
WARDOGS_RCON_PASSWORD=CHANGE_ME
# Second server for seeding only. The port must expose the WDRCON HTTP API.
WARDOGS_RCON_2_URL=http://216.144.249.92:7789
WARDOGS_RCON_2_PASSWORD=CHANGE_ME_SECOND_SERVER
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
BACKUP_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_BASE64_32_BYTES

SEED_VOICE_CHANNEL_ID=1552253117586739210
SEED_RANK_CHANNEL_ID=1552254053109727262
SEED_SHOP_CHANNEL_ID=1552255043757936721
SEED_RULES_CHANNEL_ID=1552254112060411944

AUDIT_CHANNEL_ID=1552402077068820611
BACKUP_CHANNEL_ID=1552401803184701502

# The supplied WARDOGS endpoint is HTTP. Restrict it by source IP; HTTPS is preferred.
RCON_ALLOW_INSECURE_HTTP=true
# Optional SHA-256 certificate fingerprint, without colons.
RCON_TLS_CERT_SHA256=
RCON_2_TLS_CERT_SHA256=
RCON_TIMEOUT_MS=6000
RCON_RETRY_ATTEMPTS=1
RCON_RETRY_BASE_MS=300
RCON_OUTAGE_LOG_INTERVAL_SECONDS=900
RCON_MAX_RESPONSE_BYTES=1048576

SEED_START_TIME=08:00
SEED_END_TIME=22:00
SEED_STOP_PLAYER_COUNT=20
SEED_RESUME_BELOW_SECONDS=300
SEED_TICK_SECONDS=30
SEED_SESSION_GRACE_SECONDS=180
LEADERBOARD_REFRESH_SECONDS=60
WEEKLY_AWARD_RECONCILE_SECONDS=300

VIP_1_DAY_COST=120
VIP_7_DAY_COST=360
VIP_30_DAY_COST=760
VIP_RECONCILE_SECONDS=120
DONATION_SITE_BASE_URL=https://wardogs-ru.ru
DONATION_FEED_TOKEN=CHANGE_ME_SAME_AS_DONATION_SITE
DONATION_CHECKOUT_SECRET=CHANGE_ME_SAME_AS_DONATION_SITE
DONATION_POLL_SECONDS=45

LINK_CHALLENGE_MINUTES=5
LINK_CHALLENGE_MAX_ATTEMPTS=5
DATA_DIR=/app/data
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION=30
BACKUP_HOUR_MSK=3
BACKUP_MINUTE_MSK=15
LOG_LEVEL=info
