DISCORD_TOKEN=PASTE_A_NEW_BOT_TOKEN_HERE
GUILD_ID=403186008579112973

# Persistent paths. On Bothost keep all mutable files under /app/data.
DATA_DIR=/app/data
BACKUP_DIR=/app/data/backups

# Optional before /clan-setup. The setup command will also save the selected role.
ADMIN_ROLE_ID=

# Signed PHP endpoint uploaded with the site to REG.RU.
SITE_SYNC_URL=https://wardogs-ru.ru/clan-sync.php
SITE_SYNC_SECRET=PASTE_THE_SAME_64_CHARACTER_SECRET_AS_ON_REG_RU

# Optional public address used in audit messages.
SITE_CLANS_URL=https://wardogs-ru.ru/clans/

# A separate encryption key for clan backups. Generate with: openssl rand -hex 32
# Keep it in a password manager: backups cannot be restored without it.
BACKUP_SECRET=PASTE_A_SEPARATE_64_CHARACTER_HEX_SECRET_HERE

# Optional. If state.json is lost, this ID lets the bot find the backup channel immediately.
# Without it, the bot also searches for the exact channel name 🔐・резервные-копии.
BACKUP_CHANNEL_ID=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=30

LOG_LEVEL=info
